<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RepoDigestAgent</RootNamespace>
    <AssemblyName>FoundryHostedAgent.AIGateway</AssemblyName>
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.14.0-preview.260721.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.14.0" />
    <PackageReference Include="OpenAI" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FoundryHostedAgent.AIGateway.Tests" />
  </ItemGroup>

</Project>
